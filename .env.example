# =============================================================================
# Autonomous Embedded Firmware Testing System - Environment Configuration
# Copy this file to .env and configure keys/paths as required.
# =============================================================================

# -----------------------------------------------------------------------------
# Execution Mode (demo | compile)
# demo: Uses precompiled known-good ESP32 artifact for simulation
# compile: Uses on-demand toolchain compilation
# -----------------------------------------------------------------------------
FIRMWARE_EXECUTION_MODE=demo

# -----------------------------------------------------------------------------
# Wokwi Simulation Platform (CLI & Cloud)
# -----------------------------------------------------------------------------
# Wokwi CI token for executing simulations without interactive browser auth.
# Obtain from: https://wokwi.com/dashboard/ci
WOKWI_CLI_TOKEN=

# Path to wokwi-cli executable (defaults to ./wokwi-cli.exe in workspace)
WOKWI_CLI_PATH=./wokwi-cli.exe

# Default simulation timeout in milliseconds
WOKWI_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# Embedded Toolchains: Arduino CLI & ESP32 Core
# -----------------------------------------------------------------------------
# Path to arduino-cli binary
ARDUINO_CLI_PATH=./bin/arduino-cli.exe

# Target ESP32 board FQBN (Fully Qualified Board Name)
ESP32_FQBN=esp32:esp32:esp32

# Target core package name
ARDUINO_CORE_NAME=esp32:esp32

# -----------------------------------------------------------------------------
# Host-Side C/C++ Compiler (GCC / MinGW)
# -----------------------------------------------------------------------------
# Path to GCC executable for local host harness compilation
GCC_PATH=gcc

# -----------------------------------------------------------------------------
# Google Gemini AI Service
# -----------------------------------------------------------------------------
# Google Gemini API key for automated firmware analysis
GEMINI_API_KEY=

# Gemini model identifier
GEMINI_MODEL=gemini-3.1-flash-lite

# API request timeout in seconds
GEMINI_TIMEOUT_SECONDS=60.0

# -----------------------------------------------------------------------------
# FastAPI Server & Local Artifact Storage
# -----------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
TEST_RESULTS_DIR=./test_results
DATABASE_URL=sqlite:///./firmware_tester.db
